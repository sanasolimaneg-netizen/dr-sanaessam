rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // UID حساب المالك (لازم يكون نفسه OWNER_UID في src/firebase-config.js)
    function ownerUid() { return '6hlOBP4pJCckI2rWDDY3fYHQXpr1'; }
    function isOwner() { return request.auth != null && request.auth.uid == ownerUid(); }
    function signedIn() { return request.auth != null; }
    // الحساب لازم يكون المالك أنشأه (accounts/{uid}) ومش موقوف
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.active == true;
    }

    // الحسابات والصلاحيات: المالك بس هو اللي ينشئ ويعدّل ويحذف. المستخدم يقرا حسابه هو
    // ويقدر بس يشيل علامة «لازم يغيّر كلمة السر» من حسابه.
    match /accounts/{uid} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
      allow update: if signedIn() && request.auth.uid == uid && isActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange']);
    }

    // المالك: صلاحية كاملة على كل البيانات (محتواه المشترك + حذف بيانات أي مستخدم)
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner();
    }

    // هل المستخدم عنده صفحة من الصفحات دي (المالك هو اللي بيحددها في accounts/{uid}.perms.tabs)
    function hasTab(tabs) {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.perms.tabs.hasAny(tabs);
    }
    function mine(uid) { return signedIn() && request.auth.uid == uid && isActive(); }

    // الدروس والامتحانات: أي مستخدم مفعّل يقرا اللي عملها المالك + اللي عملها هو بنفسه.
    // الكتابة في بياناته هو بس (ومحتوى المالك مابيكتبش فيه غير المالك) وحسب الصفحات المسموحة له.
    match /users/{uid}/sets/{document=**} {
      allow read: if (uid == ownerUid() && isActive()) || mine(uid);
      allow write: if mine(uid) && hasTab(['add', 'library']);
    }
    match /users/{uid}/exams/{document=**} {
      allow read: if (uid == ownerUid() && isActive()) || mine(uid);
      allow write: if mine(uid) && hasTab(['exam', 'exams']);
    }

    // خاص بكل مستخدم: نتايج امتحاناته وملفه الشخصي. صاحبه بس (وحسابه مفعّل)
    match /users/{uid}/results/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid && isActive();
    }
    match /users/{uid}/meta/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid && isActive();
    }

    // أي مسار تاني ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
